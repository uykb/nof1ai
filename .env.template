# Binance Exchange Keys (For Trading)
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
# Set to 'true' to use Binance Futures Testnet
BINANCE_TESTNET=false

# Hyperliquid Keys (For Signals/CopyTrading - Optional if only reading public data)
HYPERLIQUID_PRIVATE_KEY=your_hl_private_key_optional

OPENROUTER_API_KEY=your_openrouter_key_here
TAAPI_API_KEY=your_taapi_key_here

# Configuration
LLM_MODEL=x-ai/grok-4
HYPERLIQUID_NETWORK=mainnet
# HYPERLIQUID_BASE_URL=... (optional)

# Infrastructure (Overridden by docker-compose if running via docker)
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379/0

# App Settings
APP_PORT=3000
API_HOST=0.0.0.0
TRADING_MODE=auto

# Reasoning
REASONING_ENABLED=false
REASONING_EFFORT=high

# Assets to trade
ASSETS=BTC,ETH,SOL
INTERVAL=5m
